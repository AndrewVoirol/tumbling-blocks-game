{
  "name": "stained-glass-jenga",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "lint:wgsl": "node \"$HOME/.gemini/config/skills/gpu-project-modernizer/scripts/lint-wgsl-and-layout.mjs\" .",
    "map:symbols": "node \"$HOME/.gemini/config/skills/gpu-project-modernizer/scripts/map-symbols.mjs\"",
    "test:blast": "node \"$HOME/.gemini/config/skills/gpu-project-modernizer/scripts/test-blast.mjs\"",
    "test": "vitest run",
    "calibrate:physics": "node scripts/calibrate-mujoco-physics.mjs",
    "audit:dynamics": "node .agents/skills/vitrail-simulation-audit/scripts/audit-dynamics.mjs",
    "eval:preship": "node scripts/eval-preship-suite.mjs",
    "chaos:mp": "node scripts/chaos-multiplayer-sim.mjs",
    "verify:mp:live": "node scripts/verify-live-multiplayer-browsers.mjs",
    "bench:optical": "node scripts/optical-bench.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@mujoco/mujoco": "^4.0.0",
    "lucide-react": "^1.39.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@webgpu/types": "^0.1.74",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "volta": {
    "node": "24.21.0",
    "npm": "11.19.0"
  }
}
